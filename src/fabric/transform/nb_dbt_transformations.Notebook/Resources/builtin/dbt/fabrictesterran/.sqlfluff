[sqlfluff]
dialect = sparksql
templater = dbt
max_line_length = 120

# RF04 (keywords used as identifiers) and RF05 (identifiers containing special/unquoted-unsafe
# characters) both fight source-system column names straight out of an ERP/operational system, which
# routinely collide with reserved words or contain spaces — quoting.identifier: true in
# dbt_project.yml is how we keep them, not a lint violation. AM04 (ambiguous/unknown column count from
# a wildcard select) is excluded because staging models built via codegen commonly start from a
# `select *` before the explicit cast/rename pass is written in.
exclude_rules = RF04, RF05, AM04

[sqlfluff:templater:dbt]
project_dir = .

[sqlfluff:layout:type:comma]
line_position = leading

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
capitalisation_policy = lower
